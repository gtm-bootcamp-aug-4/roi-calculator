# Service-user API key (starts with cog_), created in Settings > Service users
DEVIN_API_KEY=cog_your_service_user_key
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# api.devin.ai for the SaaS app, or https://<your-org>.devinenterprise.com/api/v3 for an enterprise instance
DEVIN_API_BASE_URL=https://api.devin.ai/v3
DEVIN_MAX_ACU_LIMIT=5
PORT=3001
# Set to 1 to use the Ferrari sample without calling Devin.
DEMO_MODE=0
DEMO_DELAY_MS=20000
DEMO_PASSWORD=ferrari123
MAX_WAIT_SECONDS=900
# Set to 1 to generate with one LLM call (~30s) instead of a Devin session.
FAST_MODE=0
# Free tier is enough: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Used only when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
# Optional model override, e.g. gemini-3.5-flash or claude-sonnet-4-5
LLM_MODEL=
